{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peptio-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "getpeptio.com", "custom_domain": true },
    { "pattern": "www.getpeptio.com", "custom_domain": true }
  ],
  "workers_dev": false
}
